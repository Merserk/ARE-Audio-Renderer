+void CPPageOutput::UpdateAudioRendererSettings() {
+    if (m_iAudioRendererSettingsType == m_iAudioRendererType) {
+        return;
+    }
+    m_iAudioRendererSettingsType = m_iAudioRendererType;
+    m_pAudioRendererSettings.Release();
+    if (m_iAudioRendererType < 0 || m_iAudioRendererType >= m_AudioRendererDisplayNames.GetCount()
+            || m_iAudioRendererType == m_iMPCAudioRendererType || m_iAudioRendererType == m_iSaneAudioRendererType
+            || GetAudioRendererDisplayName().IsEmpty()) {
+        return;
+    }
+    CFGFilterRegistry renderer(GetAudioRendererDisplayName());
+    CInterfaceList<IUnknown, &IID_IUnknown> unused;
+    CComPtr<IBaseFilter> filter;
+    if (SUCCEEDED(renderer.Create(&filter, unused))) {
+        if (CComQIPtr<ISpecifyPropertyPages> pages = filter) {
+            CAUUID ids = {};
+            const HRESULT hr = pages->GetPages(&ids);
+            if (SUCCEEDED(hr) && ids.cElems > 0 && ids.pElems) {
+                m_pAudioRendererSettings = filter;
+            }
+            CoTaskMemFree(ids.pElems);
+        }
+    }
+}
